# Convenciones de edición (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# En la guía, el texto se sangra con tabuladores, pero el contenido de los
# bloques lstlisting empieza en la columna 0 y usa espacios (ver CONTRIBUTING.md).
[*.tex]
indent_style = tab
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
